    "/api/v1/client/status": {
      "get": {
        "operationId": "dashboard_api_api_client_status",
        "summary": "Client check license and profile status by email, phone, or device ID",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "schema": {
              "title": "Query",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientStatusOut"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientStatusOut"
                }
              }
            }
          }
        },
        "description": "Look up client registration and license status using device ID, email, or phone:\n- If customer profile submitted but license not generated yet -\u003E PENDING_LICENSE\n- If license exists and active -\u003E ACTIVE (or UNBOUND if awaiting first device activation)\n- If license expired -\u003E EXPIRED with instruction to contact administration via Phone/WhatsApp",
        "tags": [
          "Client Registration & Inquiry"
        ]
      }
    },
    "/api/v1/license/activate": {
