          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeartbeatOut"
                }
              }
            }
          }
        },
        "description": "Periodic background heartbeat check sent by desktop client timer (every 4 hours):\n- Confirms ongoing validity without interrupting the user workflow.\n- Instantly informs the desktop client if an administrator revoked or disabled the license.",
        "tags": [
          "Desktop License Lifecycle"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HeartbeatIn"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "AdminAuth": []
          }
        ]
      }
    },
    "/api/v1/license/status/{license_key}": {
      "get": {
        "operationId": "dashboard_api_api_license_status",
        "summary": "Query license status by key",
        "parameters": [
          {
            "in": "path",
            "name": "license_key",
            "schema": {
              "title": "License Key",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LicenseStatusOut"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response",
                  "type": "object"
                }
              }
            }
          }
        },
        "description": "Administrative and diagnostic status inquiry for any license key in the system.",
        "tags": [
          "Diagnostic & Inquiry"
        ],
        "security": [
          {
            "AdminAuth": []
          }
        ]
      }
    }
  },
