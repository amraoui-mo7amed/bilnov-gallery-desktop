            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientProfileOut"
                }
              }
            }
          }
        },
        "description": "Client sends a request to create a client profile:\n1. Validates full name, email, and phone/WhatsApp number.\n2. Ensures unique email and phone constraints.\n3. Creates the Customer profile.\n4. Automatically notifies platform administrators (with live SSE and in-app notifications).\n5. Instructs client to wait for an administrator to generate and deliver the license key.",
        "tags": [
          "Client Registration & Inquiry"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientProfileIn"
              }
            }
          },
          "required": true
        }
      }
    },
